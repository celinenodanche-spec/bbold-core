# Obtenir sur console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Code d'accès à l'application. Sans lui, toutes les routes /api répondent 503 :
# l'app est fermée tant qu'il n'est pas défini. Choisis une phrase longue plutôt
# qu'un mot court — c'est ce qui protège tes crédits API.
ACCESS_CODE=change-moi

# Réseaux proposés dans le Studio de Zara. Le code des trois réseaux est complet ;
# cette ligne décide lesquels sont affichés. Valeurs : instagram, linkedin, twitter
# (séparées par des virgules). Absente = instagram seul.
# Pour un studio dupliqué qui utilise aussi LinkedIn et X :
#   NEXT_PUBLIC_STUDIO_PLATFORMS=instagram,linkedin,twitter
# Sur Vercel, redéploie après l'avoir changée.
NEXT_PUBLIC_STUDIO_PLATFORMS=instagram
