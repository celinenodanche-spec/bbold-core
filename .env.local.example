# Obtenir sur console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Code d'accès à l'application. Sans lui, toutes les routes /api répondent 503 :
# l'app est fermée tant qu'il n'est pas défini. Choisis une phrase longue plutôt
# qu'un mot court — c'est ce qui protège tes crédits API.
ACCESS_CODE=change-moi
